{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/components",
  "lib": {
    "entryFile": "index.ts"
  },
  "allowedNonPeerDependencies": [
    "@codemirror/lang-angular",
    "@codemirror/lang-css",
    "@codemirror/lang-html",
    "@codemirror/lang-javascript",
    "@codemirror/lang-json",
    "@codemirror/lang-sass",
    "@ctrl/tinycolor",
    "@embedpdf/core",
    "@embedpdf/engines",
    "@embedpdf/models",
    "@ngrx/signals",
    "@tailwindcss/postcss",
    "@tailwindcss/typography",
    "@uiw/codemirror-theme-github",
    "@viselect/vanilla",
    "autoprefixer",
    "codemirror",
    "d3",
    "emojibase-data",
    "iconify-icon",
    "jsdom",
    "konva",
    "libphonenumber-js",
    "postcss",
    "rxjs",
    "shiki",
    "tailwindcss",
    "tslib",
    "uuid",
    "video.js"
  ],
  "assets": [
    "ai",
    "styles",
    "LICENSE.md",
    {
      "glob": "**/*.json",
      "input": "schematics",
      "output": "schematics"
    }
  ]
}
