{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/components",
  "lib": {
    "entryFile": "index.ts"
  },
  "allowedNonPeerDependencies": [
    "@tailwindcss/postcss",
    "@tailwindcss/typography",
    "autoprefixer",
    "postcss",
    "tailwindcss",
    "jsdom"
  ],
  "assets": [
    "ai",
    "styles",
    {
      "glob": "**/*.json",
      "input": "schematics",
      "output": "schematics"
    }
  ]
}
