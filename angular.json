{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngstarter": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ngstarter",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": [
            ],
            "server": "src/main.server.ts",
            "security": {
              "allowedHosts": ["*"]
            },
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": [
                "emojibase-data"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "ngstarter:build:production"
            },
            "development": {
              "buildTarget": "ngstarter:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ngstarter:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "browsers": ["chromium"],
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    },
    "components": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/components",
      "sourceRoot": "projects/components",
      "prefix": "ngs",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/components/tsconfig.lib.json",
            "outputPath": "dist/components",
            "assets": [
              {
                "glob": "API.md",
                "input": "projects/components/data-view",
                "output": "data-view"
              },
              {
                "glob": "document.schema.json",
                "input": "projects/components/content-editor",
                "output": "content-editor"
              },
              {
                "glob": "BLOCK_FORMAT.md",
                "input": "projects/components/content-editor",
                "output": "content-editor"
              },
              "projects/components/ai",
              "projects/components/styles",
              "projects/components/LICENSE.md",
              {
                "glob": "**/*.json",
                "input": "projects/components/schematics",
                "output": "schematics"
              }
            ],
            "allowedNonPeerDependencies": [
              "@codemirror/lang-angular",
              "@codemirror/lang-css",
              "@codemirror/lang-html",
              "@codemirror/lang-javascript",
              "@codemirror/lang-json",
              "@codemirror/lang-sass",
              "@ctrl/tinycolor",
              "@embedpdf/core",
              "@embedpdf/engines",
              "@embedpdf/models",
              "@ngrx/signals",
              "@tailwindcss/postcss",
              "@tailwindcss/typography",
              "@uiw/codemirror-theme-github",
              "@viselect/vanilla",
              "autoprefixer",
              "codemirror",
              "d3",
              "emojibase-data",
              "iconify-icon",
              "jsdom",
              "konva",
              "libphonenumber-js",
              "postcss",
              "rxjs",
              "shiki",
              "tailwindcss",
              "tslib",
              "uuid",
              "video.js"
            ]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "compilationMode": "full"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "browsers": ["chromium"],
            "runnerConfig": "vitest.config.ts"
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/docs",
      "sourceRoot": "projects/docs/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/docs/src/main.ts",
            "tsConfig": "projects/docs/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/docs/public"
              },
              {
                "glob": "document.schema.json",
                "input": "projects/components/content-editor",
                "output": "content-editor"
              },
              {
                "glob": "pdfium.wasm",
                "input": "node_modules/@embedpdf/pdfium/dist",
                "output": "assets/embedpdf"
              },
              {
                "glob": "**/_examples/**",
                "input": "projects/docs/src/app",
                "output": "_docs"
              }
            ],
            "styles": [
              "projects/docs/src/styles.scss"
            ],
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "server": "projects/docs/src/main.server.ts",
            "security": {
              "allowedHosts": ["*"]
            },
            "outputMode": "server",
            "ssr": {
              "entry": "projects/docs/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kb"
                }
              ],
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": [
                "emojibase-data"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
