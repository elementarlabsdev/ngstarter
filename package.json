{
  "name": "ngstarter",
  "description": "NgStarter - AI-friendly Enterprise Angular UI Components and Admin Panel",
  "version": "1.0.154",
  "bugs": {
    "url": "https://github.com/elementarlabsdev/ngstarter/issues"
  },
  "homepage": "https://ngstarter.com",
  "keywords": [
    "ngstarter admin",
    "angular admin",
    "admin panel",
    "angular dashboard",
    "angular admin panel",
    "angular ui components",
    "angular admin template",
    "angular ui"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng cache clean && ng serve --hmr",
    "start:docs": "ng cache clean && ng serve docs --hmr",
    "start:admin:corporate": "ng cache clean && ng serve admin-corporate --hmr",
    "start:admin:modern": "ng cache clean && ng serve admin-modern --hmr",
    "start:admin:classic": "ng cache clean && ng serve admin-classic --hmr",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:ngstarter && npm run test:components && npm run test:docs && npm run test:admin-corporate && npm run test:admin-modern && npm run test:admin-classic",
    "test:ngstarter": "ng test ngstarter --watch=false",
    "test:components": "ng test components --watch=false",
    "test:docs": "ng test docs --watch=false",
    "test:admin-corporate": "ng test admin-corporate --watch=false",
    "test:admin-modern": "ng test admin-modern --watch=false",
    "test:admin-classic": "ng test admin-classic --watch=false",
    "build": "ng build",
    "sync:components:dependencies": "node scripts/sync-components-dependencies.mjs",
    "build:components:prod": "npm run sync:components:dependencies && npm run generate:ai && ng build components --configuration production && npm run build:components:schematics",
    "build:components:schematics": "tsc -p projects/components/tsconfig.schematics.json && copyfiles -u 3 \"projects/components/schematics/**/*.json\" dist/components/schematics",
    "generate:ai": "node scripts/generate-ai-metadata.mjs",
    "verify:admin:components": "node scripts/verify-admin-components.mjs",
    "verify:components:package": "node scripts/verify-components-package.mjs",
    "build:prod": "ng build --configuration production",
    "build:docs:prod": "ng build docs --configuration production",
    "build:admin-corporate:prod": "ng build admin-corporate --configuration production",
    "build:admin-modern:prod": "ng build admin-modern --configuration production",
    "build:admin-classic:prod": "ng build admin-classic --configuration production",
    "publish:components": "npm run build:components:prod && npm run verify:components:package && cd dist/components && npm publish --access public",
    "clean": "rm -rf .angular/cache",
    "serve:ssr": "node dist/ngstarter/server/server.mjs",
    "serve:ssr:docs": "node dist/docs/server/server.mjs",
    "serve:ssr:admin-corporate": "node dist/admin-corporate/server/server.mjs",
    "serve:ssr:admin-modern": "node dist/admin-modern/server/server.mjs",
    "serve:ssr:admin-classic": "node dist/admin-classic/server/server.mjs"
  },
  "private": true,
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/localize": "^21.2.4",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/platform-server": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@angular/ssr": "^21.2.2",
    "@babel/runtime": "7.29.2",
    "@codemirror/lang-angular": "^0.1.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@ctrl/tinycolor": "^4.1.0",
    "@embedpdf/core": "^2.14.3",
    "@embedpdf/engines": "^2.14.3",
    "@embedpdf/models": "^2.14.3",
    "@embedpdf/pdfium": "^2.14.3",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/fluent": "^1.2.43",
    "@ngrx/signals": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@tiptap/core": "2.10.2",
    "@tiptap/extension-bubble-menu": "2.10.2",
    "@tiptap/extension-code-block": "2.10.2",
    "@tiptap/extension-dropcursor": "2.10.2",
    "@tiptap/extension-floating-menu": "2.10.2",
    "@tiptap/extension-history": "2.10.2",
    "@tiptap/extension-horizontal-rule": "2.10.3",
    "@tiptap/extension-image": "2.10.2",
    "@tiptap/extension-link": "2.10.4",
    "@tiptap/extension-list-item": "2.10.2",
    "@tiptap/extension-ordered-list": "2.10.2",
    "@tiptap/extension-placeholder": "2.10.2",
    "@tiptap/extension-youtube": "2.10.2",
    "@tiptap/pm": "2.10.2",
    "@tiptap/starter-kit": "2.10.2",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "@videojs/http-streaming": "^3.17.4",
    "@viselect/vanilla": "^3.9.0",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.17",
    "awesome-phonenumber": "^6.12.0",
    "codemirror": "^6.0.2",
    "copyfiles": "^2.4.1",
    "d3": "^7.9.0",
    "echarts": "^5.5.0",
    "emojibase-data": "^17.0.0",
    "express": "^5.1.0",
    "iconify-icon": "^3.0.2",
    "konva": "^10.2.3",
    "libphonenumber-js": "^1.11.15",
    "lightningcss": "^1.30.1",
    "marked": "^17.0.0",
    "ngx-markdown": "^21.1.0",
    "postcss": "^8.5.2",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "shiki": "^3.12.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.3",
    "video.js": "^8.23.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.2",
    "@angular-devkit/schematics": "^21.2.2",
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.13.2",
    "@types/uuid": "^10.0.0",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.14",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  },
  "husky": {
    "pre-push": "npm run changelog"
  }
}
